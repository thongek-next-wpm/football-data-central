PORT=5000
FOOTBALL_DATA_API_KEY=your_football_data_org_api_key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/football_data_central
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:5173

# Cache TTL (seconds) aligned with FDC Architecture Plan
CACHE_TTL_STANDINGS=7200
CACHE_TTL_TEAMS=21600
CACHE_TTL_PLAYERS=14400
CACHE_TTL_MATCHES_ACTIVE=480
CACHE_TTL_MATCHES_IDLE=3600

# Serve built-in realistic seed data when API key is missing or Free Tier returns 403
ENABLE_DEMO_FALLBACK=true
